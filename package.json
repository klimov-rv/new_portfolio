{
  "name": "klimov-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy": "npm run generate && node scripts/deploy.js",
    "deploy:preview": "npm run generate && nuxt preview",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@inspira-ui/plugins": "0.0.2",
    "@nuxt/content": "3.12.0",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "3.3.7",
    "@vueuse/core": "12.8.2",
    "better-sqlite3": "12.8.0",
    "gsap": "3.14.2",
    "motion-v": "1.10.3",
    "nuxt": "3.21.2",
    "ogl": "1.0.11",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.30",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "1.2.111",
    "@nuxt/devtools": "3.2.3",
    "@types/node": "25.5.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.11.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.7",
    "sass-embedded": "1.98.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.4",
    "@playwright/test": "1.56.1",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "18.0.1",
    "vue-tsc": "3.3.11"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}